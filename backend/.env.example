# Copiar a .env y ajustar. Ninguno de estos valores por defecto es seguro
# para producción: en especial JWT_SECRET_KEY y ADMIN_PASSWORD hay que
# cambiarlos antes de desplegar en la nube.

DATABASE_URL=postgresql://instituto_admin:instituto_pass@localhost:5432/instituto_erp
APP_NAME=Instituto ERP
ENV=local

# Local acepta el default de abajo. En producción se define como variable
# de entorno con los dominios reales separados por coma, ej:
# CORS_ORIGINS=https://instituto-erp.pages.dev,https://miinstituto.com.ar
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Zona horaria usada para todo cálculo de "hoy" (vencimientos, alertas, etc.)
APP_TIMEZONE=America/Argentina/Buenos_Aires

# --- Autenticación ---
# Cambiar SIEMPRE en producción por un valor propio y secreto.
JWT_SECRET_KEY=change-this-secret-in-production-1a2b3c
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Credenciales del usuario administrador que crea el seed la primera vez
# (solo si la tabla "usuarios" está vacía). Cambiar la contraseña desde la
# app después del primer login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=instituto2026
